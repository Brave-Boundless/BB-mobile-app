{
  "expo": {
    "name": "Brave & Boundless",
    "slug": "brave-boundless-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "braveandboundless",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.braveandboundless.app",
      "supportsTablet": false,
      "icon": "./assets/images/icon.png",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E0D0C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.braveandboundless.app"
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0D0C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#F17225"
        }
      ],
      "expo-web-browser",
      "expo-sharing",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0E0D0C",
    "extra": {
      "eas": {
        "projectId": "228a7450-d1b4-4087-ad0d-0e4d24df6aa1"
      }
    },
    "owner": "boondock-walker",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/228a7450-d1b4-4087-ad0d-0e4d24df6aa1"
    }
  }
}
